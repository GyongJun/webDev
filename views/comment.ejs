<!DOCTYPE html>
<html>
    <head>
        <link href="/header.css" rel="stylesheet" type="text/css">
        <link href="/footer.css" rel="stylesheet" type="text/css">
        <link href="/comment.css" rel="stylesheet" type="text/css">
        <script src="/jquery/jquery-3.7.1.js"></script>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Forum</title>
    </head>

    <body>
        <div class="container">
            <%- include('header') %>
            <div class="main">
                <h3 class="successMsg">
                    조작이 성공했습니다.
                </h3>
                
                <h3 class="previousPage">
                    <a href="#">
                        이전 페지로
                    </a>
                </h3>
                
                <div class="articleContainer">                
                    <div class="articleWriter">
                        <img src="/img/uploads/<%= post.user.character %>">
                        <h3><%= post.user.name %></h3>
                    </div>

                    <div class="article">
                        <%= post.text %>
                    </div>
                </div>

            <% if(!session || session._id != post.user._id) { %>    
                <div class="myCommentContainer">
                    <h3>답변글</h3>
                    <form class="myCommentMain" id="commentForm"  data-post-id ="<%= post._id %>">
                        <textarea placeholder="답변글 내용">
                        </textarea>
                        <button type="submit" class="sendComment">답변하기</button>
                    </form>
                </div>
            <% } %>
                <div class="commentsContainer">
                    <div class="commentContainer">
                        <div class="commentWriter">
                            리원혁
                        </div>
                        
                        <div class="commentMain">
                            <div class="commetText">
                                좋은 글입니다.
                            </div>
                            
                            <button class="cancelBtn">
                                X
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <%- include('footer') %>
        </div>
    </body>
    <script src="/js/comment.js"></script>
</html>