<!DOCTYPE html>
<html>
    <head>
        <link href="/header.css" rel="stylesheet" type="text/css">
        <link href="/footer.css" rel="stylesheet" type="text/css">
        <link href="/forum.css" rel="stylesheet" type="text/css">
        <script src="/jquery/jquery-3.7.1.js"></script>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Forum</title>
    </head>

    <body>
        <div class="container">
            <%- include('header') %>
            <main>
                <div class="myArticleContainer">
                    <h3>기사투고</h3>
                    <form class="myArticleMain" method="post">
                        <textarea class="myArticle" name="text"></textarea>
                        <% if(messages.success) { %>
                            <p class="successMessage">
                                <%= messages.success %>
                            </p>
                        <% } %>
                        <input type="submit" class="sendArticle" value="투고">
                    </form>
                </div>

                <div class="articlesContainer">
                    <% if(posts) { %>
                        <% posts.forEach ( post => { %>
                            <div class="item">
                                <div class="itemImg">
                                    <img src="img/uploads/<%= post.user.character %>">
                                    <h3><%= post.user.name %></h3>
                                </div>
                                <div class="itemText">
                                    <% if (session && post.user._id == session._id) { %>
                                        <textarea class="myArticle itemMyArticle" id="<%= post._id %>">
                                            <%= post.text %>
                                        </textarea>
                                        <div class="btnContainer">
                                            <button onclick="fn_update('<%= post._id %>')">수정</button>
                                            <button onclick="fn_delete('<%= post._id %>')">삭제</button>
                                            <a class="commentBtn" href="forum/comment/<%= post._id %>">답변글</a>
                                        </div>
                                    <% } else {%>
                                        <div class="text">
                                            <%= post.text %>
                                        </div>
                                        <div class="btnContainer">
                                            <button  onclick="">Agree</button>
                                            <button onclick="">Disagree</button>
                                            <a class="commentBtn" href="forum/comment/<%= post._id %>">답변글</a>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        <% }) %>
                    <% } %>
                </div>
            </main>
            <%- include ('footer') %>
        </div>
    </body>
    <script src="/js/article.js"></script>
</html>